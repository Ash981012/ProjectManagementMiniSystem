@page
@model ProjectManagement.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<section class="auth-panel">
    <h1>Register</h1>
    <form method="post" class="form-stack" data-auth-form="register" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Input.FullName"></label>
        <input asp-for="Input.FullName" autocomplete="name" />
        <span asp-validation-for="Input.FullName" class="field-error"></span>

        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="username" inputmode="email" />
        <span asp-validation-for="Input.Email" class="field-error"></span>

        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>

        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>

        <button type="submit" class="primary-button">Create account</button>
    </form>
    <p class="muted">Already registered? <a asp-page="/Account/Login">Login</a>.</p>
</section>
